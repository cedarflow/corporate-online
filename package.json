{
  "name": "corporate-online",
  "version": "0.1.0",
  "private": true,
  "description": "Internal incorporation & corporate records platform (Ownr-style), runs on Cloudflare Workers + D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply corporate-online --local",
    "db:migrate:remote": "wrangler d1 migrations apply corporate-online --remote",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "hono": "^4.10.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "typescript": "^5.9.0",
    "wrangler": "^4.163.0"
  }
}
