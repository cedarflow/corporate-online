{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "corporate-online",
  "main": "src/index.tsx",
  "compatibility_date": "2025-09-01",
  "account_id": "83b987d887d3eba4d2502e0ff13c5e02",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "corporate-online",
      "database_id": "830d9306-71fd-45fc-b31a-be3b747df930",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets (set with `npx wrangler secret put SESSION_SECRET`):
  //   SESSION_SECRET  - long random string used to sign login cookies
  //   SETUP_TOKEN     - optional; if set, first-run /setup requires ?token=<value>
}
